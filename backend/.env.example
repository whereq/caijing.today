# caijing.today API — environment configuration
# Copy to .env and adjust. The API is READ-ONLY against the shared database.

# Shared PostgreSQL (same instance as flowdesk.top). In dev via docker-compose,
# the host is the shared db container; locally, localhost.
DATABASE_URL=postgresql+asyncpg://flowdesk:flowdesk@whereq-db-dev:5432/flowdesk

# Keycloak (KeyToMarvel.com) — caijing.today has its own realm.
KEYCLOAK_URL=https://keytomarvel.com
KEYCLOAK_REALM=caijing.today-realm
KEYCLOAK_CLIENT_ID=caijing.today-spa

# API
API_HOST=0.0.0.0
API_PORT=8000

# The shared collector populates real data, so this is off by default. Enable it
# only for offline/local dev with no database attached.
SEED_FALLBACK_ENABLED=false
