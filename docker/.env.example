# caijing.today — production docker-compose env. Copy to docker/.env on the Pi.
# The DB is the SHARED whereq-db (owned by the data platform); use its real
# credentials here. The password must be URL-encoded (…_ENCODED).

POSTGRES_USER=flowdesk
POSTGRES_PASSWORD_ENCODED=flowdesk
POSTGRES_DB=flowdesk

# Keycloak (KeyToMarvel.com) — caijing.today's own realm. Browsing works without
# it; only sign-in needs the realm to exist.
KEYCLOAK_URL=https://keytomarvel.com
KEYCLOAK_REALM=caijing.today-realm
KEYCLOAK_CLIENT_ID=caijing.today-spa

# Real data is live in the shared DB — keep seed fallback off in prod.
SEED_FALLBACK_ENABLED=false
